# 변수 이름만 둡니다. 실제 값(시크릿)은 커밋하지 마세요.

# 라벨 사진을 비전 AI로 읽으려면 필요 (없으면 내장 OCR/텍스트 입력으로 폴백)
ANTHROPIC_API_KEY=

# 선택: 비전 판독에 쓸 모델 (기본 claude-opus-5). 비용을 낮추려면 claude-sonnet-5 등
VISION_MODEL=

# 저장 DB 경로 (설치형 앱이 사용자 데이터 폴더로 주입). 개발 시 비워두면 backend/db/ 사용
WOOAEYOUNG_DB=

# 외부 공개 서버: 사용자별 저장 접근을 제한하고 로컬 전용 API를 비활성화
WOOAEYOUNG_PUBLIC_SERVER=0
# Docker 배포는 0.0.0.0, 로컬 실행은 127.0.0.1
WOOAEYOUNG_HOST=127.0.0.1
WOOAEYOUNG_PORT=8756
# 프론트와 API가 같은 주소이면 비워 둡니다. 별도 프론트 주소는 쉼표로 구분.
WOOAEYOUNG_CORS_ORIGINS=

# Android: set the deployed HTTPS origin before running Capacitor sync.
WOOAEYOUNG_SERVER_URL=
